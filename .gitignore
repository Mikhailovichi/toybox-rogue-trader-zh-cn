# Local source, game terminology, snapshots and installation backups.
/reference/
/dictionary-localization/reference/*
!/dictionary-localization/reference/baseline-zh-CN.json
!/dictionary-localization/reference/extracted-keys.json
!/dictionary-localization/reference/finite-keys.json
!/dictionary-localization/reference/game-enums.json

# Reproducible packages and local validation/installation records.
/release/
/dictionary-localization/docs/installation.json
/dictionary-localization/docs/local-acceptance.md
/dictionary-localization/docs/validation.json
/dictionary-localization/docs/translation-review.json

# Python dependencies and caches.
/dictionary-localization/tools/vendor/
.venv/
__pycache__/
*.py[cod]

# Display addon build products and local build environment.
/display-enhancements/**/bin/
/display-enhancements/**/obj/
